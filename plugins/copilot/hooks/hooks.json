{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "/bin/sh \"${PLUGIN_ROOT}/runtime/hook.sh\" copilot || printf '%s\\n' '{\"permissionDecision\":\"allow\"}'",
        "matcher": "view|bash|grep",
        "timeoutSec": 20
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "/bin/sh \"${PLUGIN_ROOT}/runtime/telemetry.sh\" copilot || printf '%s\\n' '{}'",
        "timeoutSec": 20
      }
    ]
  }
}
